# Groq API key - create one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Primary model used by the agent for extraction / summarization
GROQ_MODEL=gemma2-9b-it

# Larger model used for longer-context reasoning (voice note summaries, multi-turn chat)
GROQ_MODEL_LARGE=llama-3.3-70b-versatile

# Database - Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hcp_crm
# Database - MySQL example:
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/hcp_crm

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
